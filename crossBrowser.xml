<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart Cross Browser Suite">

    <listeners>

        <listener
            class-name="utility.ExtentReportUtility"/>

    </listeners>


    <test name="Chrome Tests">

        <parameter
            name="browser"
            value="chrome"/>

        <parameter
            name="os"
            value="windows"/>

        <classes>

            <class
                name="testCases.TC001_RegistrationPage"/>

            <class
                name="testCases.TC002_LoginPage"/>

        </classes>

    </test>


    <test name="Edge Tests">

        <parameter
            name="browser"
            value="edge"/>

        <parameter
            name="os"
            value="windows"/>

        <classes>

            <class
                name="testCases.TC001_RegistrationPage"/>

            <class
                name="testCases.TC002_LoginPage"/>

        </classes>

    </test>

</suite>