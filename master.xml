<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart Master Suite">

    <listeners>

        <listener
            class-name="utility.ExtentReportUtility"/>

    </listeners>


    <test name="Chrome Tests">

        <parameter
            name="browser"
            value="chrome"/>

        <parameter
            name="os"
            value="windows"/>

        <classes>

            <class
                name="testCases.TC001_RegistrationPage"/>

            <class
                name="testCases.TC002_LoginPage"/>

            <class
                name="testCases.TC003_DataProviderLogin"/>
                
            <class 
            	name="testCases.TC004_Search"/>
            	
            <class 
            	name="testCases.TC005_AddToCart"/>
            	
            <class 
            	name="testCases.TC006_CartValidation"/>
            	
            <class 
            	name="testCases.TC007_InvalidLogin"/>
            	
            <class 
            	name="testCases.TC008_Logout"/>

        </classes>

    </test>

</suite>